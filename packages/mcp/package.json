{
  "name": "@bbmodel-tools/mcp",
  "version": "0.1.2",
  "description": "MCP server exposing @bbmodel-tools/core over stdio: inspect Blockbench .bbmodel files and extract Bedrock geometry, animations, animation controllers and textures.",
  "license": "GPL-3.0-only",
  "bin": {
    "bbmodel-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p ./",
    "prepublishOnly": "npm run build",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@bbmodel-tools/core": "*",
    "@bbmodel-tools/render": "*",
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
